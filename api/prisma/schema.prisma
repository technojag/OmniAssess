generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ADMIN
}

enum Category {
  SCHOOL
  COLLEGE
  GOVT_COMPETITIVE
  CORPORATE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum QuestionSource {
  MANUAL
  AI
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TERMINATED
  EXPIRED
}

enum SectionState {
  PENDING
  ACTIVE
  CLOSED
}

enum SectionCloseReason {
  TIME_UP
  SUBMITTED_EARLY
  TERMINATED
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  passwordHash           String
  fullName               String
  role                   Role           @default(CANDIDATE)
  hasCompletedOnboarding Boolean        @default(false)
  timezone               String         @default("Asia/Kolkata")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  profile                UserProfile?
  attempts               ExamAttempt[]
  refreshTokens          RefreshToken[]
  revisionItems          RevisionItem[]

  @@map("users")
}

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category
  details    Json     @default("{}")
  focusNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_profiles")
}

model Subject {
  id        String        @id @default(uuid())
  name      String        @unique
  topics    Topic[]
  questions Question[]
  sections  ExamSection[]

  @@map("subjects")
}

model Topic {
  id        String     @id @default(uuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  name      String
  questions Question[]

  @@unique([subjectId, name])
  @@map("topics")
}

model Question {
  id           String            @id @default(uuid())
  subjectId    String
  subject      Subject           @relation(fields: [subjectId], references: [id])
  topicId      String?
  topic        Topic?            @relation(fields: [topicId], references: [id])
  stem         String
  explanation  String?
  difficulty   Difficulty        @default(MEDIUM)
  status       QuestionStatus    @default(DRAFT)
  source       QuestionSource    @default(MANUAL)
  language     String            @default("en")
  options      QuestionOption[]
  attemptItems AttemptQuestion[]
  revisionItems RevisionItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([subjectId, status, difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String     @id @default(uuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  text       String
  isCorrect  Boolean    @default(false)
  responses  Response[]

  @@unique([questionId, position])
  @@map("question_options")
}

model ExamTemplate {
  id          String                @id @default(uuid())
  slug        String                @unique
  name        String
  category    Category
  description String?
  versions    ExamTemplateVersion[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("exam_templates")
}

model ExamTemplateVersion {
  id          String        @id @default(uuid())
  templateId  String
  template    ExamTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  status      VersionStatus @default(DRAFT)
  rules       Json          @default("{}")
  publishedAt DateTime?
  sections    ExamSection[]
  attempts    ExamAttempt[]
  createdAt   DateTime      @default(now())

  @@unique([templateId, version])
  @@map("exam_template_versions")
}

model ExamSection {
  id                    String              @id @default(uuid())
  templateVersionId     String
  templateVersion       ExamTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  position              Int
  name                  String
  subjectId             String
  subject               Subject             @relation(fields: [subjectId], references: [id])
  durationSeconds       Int
  questionCount         Int
  marksPerQuestion      Decimal             @db.Decimal(5, 2)
  negativeMarks         Decimal             @default(0) @db.Decimal(5, 2)
  allowReturnToPrevious Boolean             @default(false)
  rules                 Json                @default("{}")
  attemptSections       AttemptSection[]

  @@unique([templateVersionId, position])
  @@map("exam_sections")
}

model ExamAttempt {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   ExamTemplateVersion @relation(fields: [templateVersionId], references: [id])
  isPractice        Boolean             @default(false)
  status            AttemptStatus       @default(IN_PROGRESS)
  startedAt         DateTime            @default(now())
  submittedAt       DateTime?
  score             Decimal?            @db.Decimal(7, 2)
  maxScore          Decimal?            @db.Decimal(7, 2)
  warningCount      Int                 @default(0)
  integrityScore    Int                 @default(100)
  sections          AttemptSection[]
  questions         AttemptQuestion[]
  events            AttemptEvent[]

  @@index([userId, status])
  @@map("exam_attempts")
}

model AttemptSection {
  id            String              @id @default(uuid())
  attemptId     String
  attempt       ExamAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examSectionId String
  examSection   ExamSection         @relation(fields: [examSectionId], references: [id])
  position      Int
  state         SectionState        @default(PENDING)
  startedAt     DateTime?
  deadlineAt    DateTime?
  closedAt      DateTime?
  closeReason   SectionCloseReason?
  questions     AttemptQuestion[]

  @@unique([attemptId, examSectionId])
  @@unique([attemptId, position])
  @@index([state, deadlineAt])
  @@map("attempt_sections")
}

model AttemptQuestion {
  id               String         @id @default(uuid())
  attemptId        String
  attempt          ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptSectionId String
  attemptSection   AttemptSection @relation(fields: [attemptSectionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id])
  position         Int
  response         Response?

  @@unique([attemptSectionId, position])
  @@unique([attemptId, questionId])
  @@map("attempt_questions")
}

model Response {
  id                String          @id @default(uuid())
  attemptQuestionId String          @unique
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  selectedOption    QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  markedForReview   Boolean         @default(false)
  savedAt           DateTime        @updatedAt

  @@map("responses")
}

model AttemptEvent {
  id        String      @id @default(uuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String
  payload   Json        @default("{}")
  createdAt DateTime    @default(now())

  @@index([attemptId, createdAt])
  @@map("attempt_events")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
model RevisionItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId, createdAt])
  @@map("revision_items")
}
