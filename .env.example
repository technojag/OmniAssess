# Copy to backend/.env and frontend/.env as needed.

# SQLite (default local prototype). For PostgreSQL:
# DATABASE_URL="postgresql://omniassess:omniassess@localhost:5432/omniassess"
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-in-production"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
ML_SERVICE_URL="http://127.0.0.1:8001"

# Optional. Without a key, AI features use labeled deterministic fallbacks.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional OpenAI alternative (unused unless AI_PROVIDER=openai)
AI_PROVIDER="gemini"
OPENAI_API_KEY=""

# Integrity engine (backend-only config; never hard-code penalties in frontend).
# Enforcement flow: detection -> confidence gate -> violation -> warning -> terminate.
# A signal below its confidence threshold is LOGGED only (no warning, no penalty),
# so single noisy CV frames can never end a test.
# Confirmed violations are counted; reaching PROCTOR_MAX_WARNINGS terminates.
PROCTOR_MAX_WARNINGS=3
INTEGRITY_TERMINATE_BELOW=35

# Per-kind confidence thresholds for computer-vision signals.
# Browser signals (tab/window/camera/mic) are exact and use a threshold of 0.
CONF_PHONE=0.6
CONF_PERSONS=0.6
CONF_FACES=0.6
CONF_NO_FACE=0.55
CONF_FACE_AWAY=0.6
CONF_GAZE=0.6

# Zero-tolerance signals: first confirmed detection terminates the test.
PENALTY_TAB_SWITCH=10
PENALTY_WINDOW_CHANGE=10
PENALTY_CAMERA_DISABLED=15
PENALTY_MIC_DISABLED=15

# Evidence signals (warning ladder).
PENALTY_TAB_HIDDEN=4
PENALTY_WINDOW_BLUR=3
PENALTY_PHONE_DETECTED=12
PENALTY_MULTIPLE_PERSONS=10
PENALTY_MULTIPLE_FACES=10
PENALTY_NO_FACE=3
PENALTY_FACE_AWAY=2
PENALTY_GAZE_AWAY=2
PENALTY_VOICE_ACTIVITY=1
PENALTY_SUSPICIOUS_ACTIVITY=8
PENALTY_OTHER=2
