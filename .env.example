# Copy to backend/.env and frontend/.env as needed.

# SQLite (default local prototype). For PostgreSQL:
# DATABASE_URL="postgresql://omniassess:omniassess@localhost:5432/omniassess"
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-in-production"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
ML_SERVICE_URL="http://127.0.0.1:8001"

# Optional. Without a key, AI features use labeled deterministic fallbacks.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional OpenAI alternative (unused unless AI_PROVIDER=openai)
AI_PROVIDER="gemini"
OPENAI_API_KEY=""

# Integrity engine (backend-only config; never hard-code penalties in frontend).
# Score starts at INTEGRITY_START_SCORE and each validated signal subtracts its penalty.
PENALTY_TAB_HIDDEN=4
PENALTY_WINDOW_BLUR=3
PENALTY_NO_FACE=3
PENALTY_MULTIPLE_FACES=8
PENALTY_FACE_AWAY=2
PENALTY_VOICE_ACTIVITY=1
PENALTY_OTHER=2
# Optional auto-terminate threshold (score below this can end a session).
INTEGRITY_TERMINATE_BELOW=35
